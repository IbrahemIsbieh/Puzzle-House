<odoo>
    <data noupdate="1">
        <record id="sequence_mystery_booking" model="ir.sequence">
            <field name="name">Mystery Booking</field>
            <field name="code">mystery.booking</field>
            <field name="prefix">BKG/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="sequence_mystery_session" model="ir.sequence">
            <field name="name">Mystery Game Session</field>
            <field name="code">mystery.session</field>
            <field name="prefix">SES/%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
