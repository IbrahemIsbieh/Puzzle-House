<odoo>
    <record id="mystery_room_view_list" model="ir.ui.view">
        <field name="name">mystery.room.list</field>
        <field name="model">mystery.room</field>
        <field name="arch" type="xml">
            <list string="Mystery Rooms">
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="difficulty"/>
                <field name="duration_minutes"/>
                <field name="price"/>
                <field name="booking_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="mystery_room_view_form" model="ir.ui.view">
        <field name="name">mystery.room.form</field>
        <field name="model">mystery.room</field>
        <field name="arch" type="xml">
            <form string="Mystery Room">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="capacity"/>
                            <field name="difficulty"/>
                        </group>
                        <group>
                            <field name="duration_minutes"/>
                            <field name="price"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description"><field name="description"/></page>
                        <page string="Bookings">
                            <field name="booking_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="team_id"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mystery_room_action" model="ir.actions.act_window">
        <field name="name">Mystery Rooms</field>
        <field name="res_model">mystery.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
