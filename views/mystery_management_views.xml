<odoo>
    <record id="mystery_puzzle_view_list" model="ir.ui.view">
        <field name="name">mystery.puzzle.list</field>
        <field name="model">mystery.puzzle</field>
        <field name="arch" type="xml">
            <list string="Puzzles">
                <field name="name"/>
                <field name="code"/>
                <field name="difficulty"/>
                <field name="points"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="mystery_puzzle_view_form" model="ir.ui.view">
        <field name="name">mystery.puzzle.form</field>
        <field name="model">mystery.puzzle</field>
        <field name="arch" type="xml">
            <form string="Puzzle">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="difficulty"/>
                            <field name="points"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="answer" password="True"/>
                            <field name="scenario_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question"><field name="question"/></page>
                        <page string="Hint"><field name="hint"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mystery_puzzle_action" model="ir.actions.act_window">
        <field name="name">Puzzles</field>
        <field name="res_model">mystery.puzzle</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="mystery_scenario_view_list" model="ir.ui.view">
        <field name="name">mystery.scenario.list</field>
        <field name="model">mystery.scenario</field>
        <field name="arch" type="xml">
            <list string="Scenarios">
                <field name="name"/>
                <field name="difficulty"/>
                <field name="estimated_duration"/>
                <field name="puzzle_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="mystery_scenario_view_form" model="ir.ui.view">
        <field name="name">mystery.scenario.form</field>
        <field name="model">mystery.scenario</field>
        <field name="arch" type="xml">
            <form string="Scenario">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="difficulty"/>
                            <field name="estimated_duration"/>
                            <field name="active"/>
                            <field name="puzzle_count" readonly="1"/>
                        </group>
                        <group><field name="puzzle_ids" widget="many2many_tags"/></group>
                    </group>
                    <field name="description" placeholder="Describe the story and objectives..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mystery_scenario_action" model="ir.actions.act_window">
        <field name="name">Scenarios</field>
        <field name="res_model">mystery.scenario</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="mystery_team_view_list" model="ir.ui.view">
        <field name="name">mystery.team.list</field>
        <field name="model">mystery.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="member_count"/>
                <field name="booking_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="mystery_team_view_form" model="ir.ui.view">
        <field name="name">mystery.team.form</field>
        <field name="model">mystery.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="member_count"/>
                            <field name="booking_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes"><field name="notes"/></page>
                        <page string="Bookings">
                            <field name="booking_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="room_id"/>
                                    <field name="scenario_id"/>
                                    <field name="start_datetime"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mystery_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">mystery.team</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="mystery_booking_view_list" model="ir.ui.view">
        <field name="name">mystery.booking.list</field>
        <field name="model">mystery.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name"/>
                <field name="team_id"/>
                <field name="room_id"/>
                <field name="scenario_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="player_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'completed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="mystery_booking_view_form" model="ir.ui.view">
        <field name="name">mystery.booking.form</field>
        <field name="model">mystery.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm_booking" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete_booking" type="object" string="Complete" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel_booking" type="object" string="Cancel" invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state in ['draft', 'completed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="room_id"/>
                            <field name="scenario_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="player_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes"><field name="notes"/></page>
                        <page string="Game Sessions">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="state"/>
                                    <field name="score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mystery_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">mystery.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
